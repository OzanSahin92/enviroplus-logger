[Unit]
Description=Enviro+ durable AWS IoT telemetry agent
Wants=network-online.target
After=network-online.target

[Service]
EnvironmentFile=/etc/enviroplus-agent/env
ExecStart=/usr/local/bin/enviroplus-agent --endpoint ${IOT_ENDPOINT} --device-id ${DEVICE_ID} --certificate /etc/enviroplus-agent/device.pem.crt --private-key /etc/enviroplus-agent/private.pem.key --root-ca /etc/enviroplus-agent/AmazonRootCA1.pem --spool /var/lib/enviroplus-agent/telemetry.db --count 0
Restart=on-failure
User=enviroplus
Group=enviroplus
RestartSec=10
StateDirectory=enviroplus-agent
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
